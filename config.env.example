# Copy to config.env and chmod 600 - it will hold an API token.

CONFLUENCE_SITE=https://baconexp.atlassian.net

# The address that actually logs into that site.
CONFLUENCE_EMAIL=you@example.com

# https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=

BACKUP_ROOT=/path/to/storage/baconexp-backups

# Abort unless this is a live mountpoint, so a failed mount cannot silently
# fill the root filesystem instead. Leave blank to disable.
REQUIRE_MOUNT=/path/to/storage

KEEP_ARCHIVES=12
